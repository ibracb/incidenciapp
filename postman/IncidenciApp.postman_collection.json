      "name": "Register first issue",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Register first issue: should return 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "let location = pm.response.headers.get(\"Location\");\r",
              "\r",
              "let id = location.split(\"/\").pop();\r",
              "\r",
              "pm.environment.set(\"firstIssueId\", id);\r",
              "\r",
              "console.log(\"First issue id saved:\", id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
